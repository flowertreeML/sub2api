# W1 本地开发环境变量样例
# 复制本文件为 deploy/.env 并填入实际值；deploy/.env 不入 git。
#
# 使用：
#   cp .env.example deploy/.env
#   # 编辑 deploy/.env 填 GLM_API_KEY 与其他必要值
#   cd deploy && docker compose -f docker-compose.dev.yml --env-file .env up -d --build

# 必填：智谱 GLM 国内 API Key（创建 GLM 账号时填入 Admin UI）
GLM_API_KEY=

# 数据库与缓存（与 deploy/docker-compose.dev.yml 联动）
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=sub2api_local_dev
POSTGRES_DB=sub2api
REDIS_PASSWORD=

# 管理员初始账号（首次启动时由 AUTO_SETUP 使用）
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=admin12345

# 安全密钥（仅本地开发使用，禁止用于生产）
JWT_SECRET=local-dev-only-do-not-use-in-prod-2026
TOTP_ENCRYPTION_KEY=  # 必填：32 字节 hex（64 字符）。生成命令：openssl rand -hex 32

# 其他
TZ=Asia/Shanghai
BIND_HOST=127.0.0.1
SERVER_PORT=8080
